<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">@dimen/dp_80</item>
        <item name="itemIconSize">@dimen/dp_24</item>
        <item name="itemPaddingTop">@dimen/dp_12</item>
        <item name="itemPaddingBottom">@dimen/dp_16</item>
        <item name="itemTextAppearanceActive">@style/MainNavLabel</item>
        <item name="itemTextAppearanceInactive">@style/MainNavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/MainNavIndicator</item>
    </style>

    <style name="MainNavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/sp_12</item>
    </style>

    <style name="MainNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">@dimen/dp_64</item>
        <item name="android:height">@dimen/dp_32</item>
    </style>
</resources>
