<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Shadow ring: outermost, faintest -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#0A000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>

    <!-- 2. Shadow ring: middle -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#14000000" />
            <corners android:radius="25dp" />
        </shape>
    </item>

    <!-- 3. Shadow ring: closest, darkest -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#22000000" />
            <corners android:radius="23dp" />
        </shape>
    </item>

    <!-- 4. Clear glass body -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_body" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 5. Light shining in from the top-left corner -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/glass_light_start"
                android:centerColor="@color/glass_light_center"
                android:endColor="@color/glass_light_end"
                android:angle="315" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 6. Bright outer rim -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_rim" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 7. Faint inner rim for a thick-glass edge -->
    <item
        android:left="7.5dp"
        android:top="7.5dp"
        android:right="7.5dp"
        android:bottom="7.5dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim_inner" />
            <corners android:radius="20.5dp" />
        </shape>
    </item>

</layer-list>